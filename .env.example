# Domain RAG System - Production Environment Configuration Template
# Copy this file to .env and supply genuine, high-entropy secrets for deployment.
# NEVER commit the filled .env file to source control.

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Security Credentials
# Generate with: openssl rand -hex 32
SECURITY_API_KEY=replace_with_strong_production_master_api_key_min_32_chars
# Optional: JSON dictionary mapping tenant-specific API keys to tenant IDs
# e.g., '{"tenant_key_abc": "tenant_1", "tenant_key_xyz": "tenant_2"}'
SECURITY_TENANT_API_KEYS={}

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_DB=rag_db
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_min_16_chars
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
VECTOR_STORE_PROVIDER=pgvector

# Redis Configuration (Rate limiting & caching)
REDIS_PASSWORD=replace_with_strong_redis_auth_password_min_16_chars
SECURITY_RATE_LIMIT_BACKEND=redis

# Observability
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_ENABLE_METRICS=true
